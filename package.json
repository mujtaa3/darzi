{
  "name": "marzi",
  "version": "0.1.0",
  "description": "Run LLM-generated widgets safely inside your web app.",
  "keywords": [
    "llm",
    "ai",
    "widgets",
    "generative-ui",
    "sandbox",
    "iframe",
    "csp",
    "mcp",
    "mcp-apps",
    "security"
  ],
  "license": "MIT",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./prompts/*": "./prompts/*"
  },
  "files": [
    "dist",
    "src",
    "prompts"
  ],
  "scripts": {
    "build": "node scripts/stub.mjs && tsc",
    "watch": "node scripts/stub.mjs && tsc --watch",
    "clean": "rm -rf dist",
    "test": "playwright test -c tests/playwright.config.ts"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@playwright/test": "^1.63.0",
    "typescript": "^5.7.2"
  }
}
